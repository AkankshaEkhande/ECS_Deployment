{
  "family": "expense-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::123240249086:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "database",
      "image": "123240249086.dkr.ecr.<REGION>.amazonaws.com/expense-postgres:v1",
      "essential": true,
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "appuser"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "apppass"
        },
        {
          "name": "POSTGRES_DB",
          "value": "expenses"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "pg_isready -U appuser -d expenses"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/expense-task",
          "awslogs-create-group": "true",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "database"
        }
      }
    },
    {
      "name": "backend",
      "image": "123240249086.dkr.ecr.<REGION>.amazonaws.com/expense-backend:v4",
      "essential": true,
      "dependsOn": [
        {
          "containerName": "database",
          "condition": "HEALTHY"
        }
      ],
      "portMappings": [
        {
          "containerPort": 5000,
          "hostPort": 5000,
          "protocol": "tcp",
          "name": "backend-5000-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "DB_NAME",
          "value": "expenses"
        },
        {
          "name": "DB_HOST",
          "value": "127.0.0.1"
        },
        {
          "name": "DB_PORT",
          "value": "5432"
        },
        {
          "name": "DB_USER",
          "value": "appuser"
        },
        {
          "name": "DB_PASSWORD",
          "value": "apppass"
        },
        {
          "name": "JWT_SECRET",
          "value": "<JWT_SECRET>"
        },
        {
          "name": "COOKIE_SECURE",
          "value": "false"
        },
        {
          "name": "EMAIL_BACKEND",
          "value": "console"
        },
        {
          "name": "EMAIL_FROM",
          "value": "SpendSight <no-reply@example.com>"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5000/api/health')"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 5,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/expense-task",
          "awslogs-create-group": "true",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "backend"
        }
      }
    },
    {
      "name": "frontend",
      "image": "123240249086.dkr.ecr.<REGION>.amazonaws.com/expense-frontend:v4",
      "essential": true,
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ],
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "name": "frontend-80-tcp"
        }
      ],
      "environment": [
        {
          "name": "BACKEND_HOST",
          "value": "127.0.0.1"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/expense-task",
          "awslogs-create-group": "true",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "frontend"
        }
      }
    }
  ]
}