# copy to .env and change the values
DB_NAME=expenses
DB_USER=appuser
DB_PASSWORD=user@123
APP_PORT=8080

# signs the login cookie. Generate one with:  openssl rand -hex 32
JWT_SECRET=1f651ef90812329a2d8f438369be16f36f0e14a884c122073f2befba07125961
# keep false while you use plain http; set true once the site is served over https
COOKIE_SECURE=false

# --- email verification ---
# smtp    -> local Mailpit inbox at http://localhost:8025 (default in docker compose)
# console -> codes are printed in the backend log (no email service needed)
# ses     -> Amazon SES (AWS; needs an IAM task role, see README)
EMAIL_BACKEND=smtp
EMAIL_FROM=SpendSight <no-reply@spendsight.local>
